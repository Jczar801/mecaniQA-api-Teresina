{
  "info": {
    "name": "MecâniQA API - OAT 1 (Rotas e Testes)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection baseada exatamente nos modelos Peca e Servico e nos endpoints implementados em PecaController.java e ServicoController.java."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "pecaId",
      "value": "1"
    },
    {
      "key": "servicoId",
      "value": "1"
    },
    {
      "key": "idInexistente",
      "value": "999999"
    }
  ],
  "item": [
    {
      "name": "Peças",
      "item": [
        {
          "name": "1. Criar peça",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoBarras\": \"789000000001\",\n  \"fornecedorMarca\": \"Bosch\",\n  \"quantidadeEstoque\": 10,\n  \"precoCusto\": 80.5,\n  \"precoVenda\": 129.9,\n  \"tamanho\": null,\n  \"cor\": null,\n  \"categoria\": \"ELETRICA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pecas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status deve ser 201 Created\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test(\"A peça recebeu um código\", function () { pm.expect(json.codigo).to.exist; });",
                  "if (json.codigo) pm.collectionVariables.set(\"pecaId\", String(json.codigo));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Listar peças",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/pecas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status deve ser 200 OK\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Buscar peça por código",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/pecas/{{pecaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas",
                "{{pecaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status deve ser 200 OK\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Buscar peça inexistente - 404 Not Found",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/pecas/{{idInexistente}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas",
                "{{idInexistente}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status deve ser 404 Not Found\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Atualizar peça",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoBarras\": \"789000000001\",\n  \"fornecedorMarca\": \"Bosch\",\n  \"quantidadeEstoque\": 15,\n  \"precoCusto\": 82.0,\n  \"precoVenda\": 134.9,\n  \"categoria\": \"ELETRICA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pecas/{{pecaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas",
                "{{pecaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status deve ser 200 OK\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Excluir peça",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/pecas/{{pecaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas",
                "{{pecaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status deve ser 204 No Content\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
